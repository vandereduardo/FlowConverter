<Window x:Class="FlowConverter.Windows.Views.RadialWheelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FlowConverter.Windows.Localization"
        Title="{loc:Text FlowConverter_Wheel}"
        Width="360" Height="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        DragEnter="OnWindowDragEnter"
        DragOver="OnWindowDragOver"
        DragLeave="OnWindowDragLeave"
        Drop="OnWindowDrop"
        MouseMove="OnWindowMouseMove"
        MouseLeftButtonDown="OnWindowMouseLeftButtonDown"
        KeyDown="OnWindowKeyDown">
    <Grid Width="360" Height="360" Background="#01000000">
        <Ellipse Width="336" Height="336" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Stroke="#BAFFFFFF" StrokeThickness="1.5" IsHitTestVisible="False">
            <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#B0F4F1EC" Offset="0"/>
                    <GradientStop Color="#987B7772" Offset="1"/>
                </LinearGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <DropShadowEffect Color="#282522" BlurRadius="14" ShadowDepth="2" Opacity="0.26"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Dynamic Petals Canvas -->
        <Canvas x:Name="PetalsCanvas" Width="360" Height="360" IsHitTestVisible="False"/>

        <!-- Center Hub Disk (102x102) -->
        <Border x:Name="CenterHubBorder"
                Width="104" Height="104"
                CornerRadius="52"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#E6FFFFFF"
                BorderThickness="1.3"
                IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FCFCFAF7" Offset="0.0"/>
                    <GradientStop Color="#E8E1DDD8" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#302B27" BlurRadius="8" ShadowDepth="1" Opacity="0.22"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,4">
                <TextBlock x:Name="HubModeText"
                           Text="{loc:Text CONVERT}"
                           Foreground="#423B36"
                           FontSize="10.5"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="HubDescriptionText"
                           Text="{loc:Text Choose_format}"
                           Foreground="#211F1D"
                           FontSize="11"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="86"
                           Margin="0,3,0,2"/>
                <TextBlock x:Name="HubSubtleText"
                           Text="{loc:Text Click_hub_to_switch}"
                           Foreground="#544B45"
                           FontSize="8.5"
                           MaxWidth="72"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
