<Window x:Class="FlowConverter.Windows.Views.RadialWheelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FlowConverter.Windows.Localization"
        Title="{loc:Text FlowConverter_Wheel}"
        Width="360" Height="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        DragEnter="OnWindowDragEnter"
        DragOver="OnWindowDragOver"
        DragLeave="OnWindowDragLeave"
        Drop="OnWindowDrop"
        MouseMove="OnWindowMouseMove"
        MouseLeftButtonDown="OnWindowMouseLeftButtonDown"
        KeyDown="OnWindowKeyDown">
    <Grid Width="360" Height="360" Background="#01000000">
        <!-- Soft Radial Backdrop Glow -->
        <Ellipse Width="346" Height="346" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#99080B12" Offset="0.0"/>
                    <GradientStop Color="#55080B12" Offset="0.72"/>
                    <GradientStop Color="#00080B12" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Dynamic Petals Canvas -->
        <Canvas x:Name="PetalsCanvas" Width="360" Height="360" IsHitTestVisible="False"/>

        <!-- Center Hub Disk (102x102) -->
        <Border x:Name="CenterHubBorder"
                Width="104" Height="104"
                CornerRadius="52"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#00E5FF"
                BorderThickness="1.8"
                IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F4171D2B" Offset="0.0"/>
                    <GradientStop Color="#F80D111A" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#00E5FF" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,4">
                <TextBlock x:Name="HubModeText"
                           Text="{loc:Text CONVERT}"
                           Foreground="#00E5FF"
                           FontSize="10.5"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="HubDescriptionText"
                           Text="{loc:Text Choose_format}"
                           Foreground="#F0F4FA"
                           FontSize="11"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="86"
                           Margin="0,3,0,2"/>
                <TextBlock x:Name="HubSubtleText"
                           Text="{loc:Text Click_hub_to_switch}"
                           Foreground="#8A99B5"
                           FontSize="8.5"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
