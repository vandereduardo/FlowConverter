<UserControl x:Class="FlowConverter.Windows.Views.AudioTrimEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FlowConverter.Windows.Localization">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#263449"/>
            <Setter Property="Foreground" Value="#F0F4FA"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="5" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#F0F4FA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TimeCard" TargetType="Border">
            <Setter Property="Background" Value="#171F2D"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style x:Key="TimeTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9DAEC7"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="TimeValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="SetupButton" Content="{loc:Text Set_up_FFmpeg}" Click="Setup_Click" Visibility="Collapsed"
                    Background="#00E5FF" Foreground="#101520" Margin="0,0,10,0"/>
            <TextBlock x:Name="Status" Text="{loc:Text Reading_audio_waveform}" Foreground="#9DAEC7"
                       VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel x:Name="Editor" IsEnabled="False">
            <DockPanel Margin="0,0,0,12">
                <TextBlock x:Name="Total" DockPanel.Dock="Right" Foreground="#9DAEC7" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PlayButton" Content="{loc:Text Play_Selected_Range}" Click="Play_Click"
                            Background="#00E5FF" Foreground="#101520" Margin="0,0,8,0"/>
                    <Button Content="{loc:Text Reset_Full_Audio}" Click="Reset_Click"/>
                </StackPanel>
            </DockPanel>
            <Border Background="#101B25" CornerRadius="8" Padding="2" Margin="0,0,0,14">
                <Grid Height="176" ClipToBounds="True">
                    <Canvas x:Name="Waveform" IsHitTestVisible="False"/>
                    <Canvas x:Name="Timeline" Background="Transparent" SizeChanged="Timeline_SizeChanged"
                            MouseLeftButtonDown="Timeline_MouseDown" MouseMove="Timeline_MouseMove"
                            MouseLeftButtonUp="Timeline_MouseUp" LostMouseCapture="Timeline_LostMouseCapture"
                            AutomationProperties.Name="{loc:Text Audio_range_timeline}"/>
                </Grid>
            </Border>

            <UniformGrid Columns="3">
                <Border Style="{StaticResource TimeCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Text START_LEFT_BAR}" Style="{StaticResource TimeTitle}"/>
                        <WrapPanel Margin="0,5,0,0">
                            <TextBlock x:Name="StartTime" Style="{StaticResource TimeValue}" Margin="0,0,6,0"/>
                            <Button Content="−0.1s" Tag="-0.1" Click="NudgeStart_Click" Padding="4,2" Margin="0,0,4,0"
                                    AutomationProperties.Name="{loc:Text Move_start_0_1_seconds_earlier}"/>
                            <Button Content="+0.1s" Tag="0.1" Click="NudgeStart_Click" Padding="4,2"
                                    AutomationProperties.Name="{loc:Text Move_start_0_1_seconds_later}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TimeCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Text END_RIGHT_BAR}" Style="{StaticResource TimeTitle}"/>
                        <WrapPanel Margin="0,5,0,0">
                            <TextBlock x:Name="EndTime" Style="{StaticResource TimeValue}" Margin="0,0,6,0"/>
                            <Button Content="−0.1s" Tag="-0.1" Click="NudgeEnd_Click" Padding="4,2" Margin="0,0,4,0"
                                    AutomationProperties.Name="{loc:Text Move_end_0_1_seconds_earlier}"/>
                            <Button Content="+0.1s" Tag="0.1" Click="NudgeEnd_Click" Padding="4,2"
                                    AutomationProperties.Name="{loc:Text Move_end_0_1_seconds_later}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TimeCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:Text SELECTED_DURATION}" Style="{StaticResource TimeTitle}"/>
                        <TextBlock x:Name="SelectedDuration" Style="{StaticResource TimeValue}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <TextBlock Text="{loc:Text Drag_either_bar_to_set_the}"
                       Foreground="#9DAEC7" Margin="0,12,0,12" TextWrapping="Wrap"/>
            <Border Height="1" Background="#29374B" Margin="0,0,0,12"/>
            <CheckBox x:Name="TrimSilence" Content="{loc:Text Trim_silent_ends_automatically}" Foreground="#F0F4FA"
                      Checked="TrimSilence_Changed" Unchecked="TrimSilence_Changed"/>
            <DockPanel x:Name="SilenceOptions" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ThresholdLabel" DockPanel.Dock="Left" Foreground="#9DAEC7" Margin="0,0,12,0"/>
                <Slider x:Name="Threshold" Minimum="-80" Maximum="-10" Value="-45" TickFrequency="1"
                        IsSnapToTickEnabled="True" ValueChanged="Threshold_Changed"
                        AutomationProperties.Name="{loc:Text Silence_threshold_in_decibels}"/>
            </DockPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
