<Window x:Class="FlowConverter.Windows.Views.LanguageSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowConverter · Language / Idioma" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#101520" Foreground="#F0F4FA">
    <StackPanel Margin="24">
        <TextBlock Text="Choose your language" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Escolha seu idioma" FontSize="15" Foreground="#9DAEC7" Margin="0,4,0,16"/>
        <ComboBox x:Name="LanguagePicker" DisplayMemberPath="Name" SelectedValuePath="Code"
                  AutomationProperties.Name="Language / Idioma" Height="34"/>
        <Button Content="Continue / Continuar" IsDefault="True" Click="Continue_Click"
                HorizontalAlignment="Right" Margin="0,18,0,0" Padding="12,6"
                Background="#00E5FF" Foreground="#101520" FontWeight="SemiBold"/>
    </StackPanel>
</Window>
