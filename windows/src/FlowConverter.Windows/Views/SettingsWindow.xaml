<Window x:Class="FlowConverter.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FlowConverter.Windows.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:FlowConverter.Windows.Models"
        mc:Ignorable="d"
        Title="{loc:Text Flow_Converter_Settings}"
        Width="820" Height="580"
        MinWidth="820" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ThemeWindow}"
        Foreground="{StaticResource ThemeText}"
        FontFamily="Segoe UI, Segoe UI Variable Display, sans-serif">

    <Window.Resources>
        <!-- Dark ScrollBar Style -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="3" Background="{StaticResource ThemeBorder}" Margin="1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" Value="{StaticResource ThemeOutline}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="true">
                                <Setter Property="Background" Value="{StaticResource ThemeAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeBorder}"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsMouseOver}">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style (inherits custom dark ControlTemplate from App.xaml) -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="{StaticResource ThemeCard}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeOutline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <!-- Dark TextBox Style (inherits custom dark ControlTemplate from App.xaml) -->
        <Style x:Key="DarkTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{StaticResource ThemeCard}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeOutline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="CaretBrush" Value="{StaticResource ThemeAccent}"/>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryAccentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ThemeAccent}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeCanvas}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ThemeAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ThemeAccentPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button Style -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ThemeControl}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeSecondaryText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ThemeHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ThemeFocus}"/>
                                <Setter Property="Foreground" Value="{StaticResource ThemeAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ThemeCard}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Icon Button Style -->
        <Style x:Key="SmallIconButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ThemeCard}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeSecondaryText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ThemeBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource ThemeAccent}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ThemeFocus}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Icon Button Style -->
        <Style x:Key="DangerIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeDanger}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ThemeDangerWash}"/>
                                <Setter Property="Foreground" Value="{StaticResource ThemeDanger}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ActiveIndicator" Grid.Column="0" Background="{StaticResource ThemeAccent}" CornerRadius="1.5" Visibility="Collapsed"/>
                                <TextBlock x:Name="NavIcon" Grid.Column="1" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="13.5" Foreground="{StaticResource ThemeSecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavText" Grid.Column="2" Text="{TemplateBinding Content}" FontSize="12" Foreground="{StaticResource ThemeSecondaryText}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ThemeCard}"/>
                                <Setter TargetName="NavText" Property="Foreground" Value="{StaticResource ThemeText}"/>
                                <Setter TargetName="NavIcon" Property="Foreground" Value="{StaticResource ThemeAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource ThemeWindow}">
        <Grid.ColumnDefinitions>
            <!-- Sidebar: Width 210 -->
            <ColumnDefinition Width="210"/>
            <!-- Content Area: Fill -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource ThemeCard}" BorderBrush="{StaticResource ThemeControl}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Brand Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Navigation Tabs -->
                    <RowDefinition Height="*"/>
                    <!-- Footer Info -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="14,16,14,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="26" Height="26" Margin="0,0,9,0"
                               Source="/FlowConverter;component/Resources/AppIcon.ico"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FLOW CONVERTER" Foreground="{StaticResource ThemeAccent}" FontSize="11.5" FontWeight="Bold"/>
                            <TextBlock Text="{loc:Text Settings_Preferences}" Foreground="{StaticResource ThemeSecondaryText}" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource ThemeControl}" Margin="0,14,0,0"/>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Row="1" Margin="8,4,8,0">
                    <Button x:Name="BtnNavGeneral" Style="{StaticResource SidebarNavButtonStyle}" Tag="&#xE713;" Content="{loc:Text General}" Click="SidebarTab_Click"/>
                    <Button x:Name="BtnNavPrinters" Style="{StaticResource SidebarNavButtonStyle}" Tag="&#xE749;" Content="{loc:Text 3D_Printers_3MF}" Click="SidebarTab_Click"/>
                    <Button x:Name="BtnNavShortcuts" Style="{StaticResource SidebarNavButtonStyle}" Tag="&#xE765;" Content="{loc:Text Wheel_Shortcuts}" Click="SidebarTab_Click"/>
                    <Button x:Name="BtnNavConversions" Style="{StaticResource SidebarNavButtonStyle}" Tag="&#xE895;" Content="{loc:Text Conversion_Defaults}" Click="SidebarTab_Click"/>
                    <Button x:Name="BtnNavCompression" Style="{StaticResource SidebarNavButtonStyle}" Tag="&#xE7B8;" Content="{loc:Text Compression}" Click="SidebarTab_Click"/>
                    <Button x:Name="BtnNavFolders" Style="{StaticResource SidebarNavButtonStyle}" Tag="&#xE8B7;" Content="{loc:Text Folders}" Click="SidebarTab_Click"/>
                    <Button x:Name="BtnNavMatrix" Style="{StaticResource SidebarNavButtonStyle}" Tag="&#xF0E2;" Content="{loc:Text Format_Matrix}" Click="SidebarTab_Click"/>
                </StackPanel>

                <!-- Footer Status -->
                <StackPanel Grid.Row="2" Margin="14,10,14,14" Opacity="0.8">
                    <Border Height="1" Background="{StaticResource ThemeControl}" Margin="0,0,0,10"/>
                    <TextBlock Text="{loc:Text Open_Source_Unlocked_MIT}" Foreground="{StaticResource ThemeMutedText}" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Text Clean_Room_Windows_Parity}" Foreground="{StaticResource ThemeMutedText}" FontSize="9" Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT CONTENT AREA -->
        <Grid Grid.Column="1" Background="{StaticResource ThemeWindow}">
            <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0" Padding="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- TAB 0: GENERAL -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,20,24,24">
                            <!-- Section Title -->
                            <TextBlock Text="{loc:Text General_Settings}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                            <TextBlock Text="{loc:Text Application_behavior_visual_themes_and_startup}" FontSize="12" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,16"/>

                            <!-- Status Card: Open Source Unlocked -->
                            <Border Background="{StaticResource ThemeCard}" BorderBrush="{StaticResource ThemeHover}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource ThemeCard}" BorderBrush="{StaticResource ThemeOutline}" BorderThickness="1.2" Margin="0,0,12,0">
                                        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource ThemeAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{loc:Text Open_Source_Unlocked_MIT_Edition}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource ThemeText}"/>
                                        <TextBlock Text="{loc:Text Unlimited_conversions_batch_drops_all_29}" FontSize="11.5" Foreground="{StaticResource ThemeSecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{StaticResource ThemeCard}" BorderBrush="{StaticResource ThemeOutline}" BorderThickness="1" CornerRadius="5" Padding="10,5" VerticalAlignment="Center">
                                        <TextBlock x:Name="UsageCountTextBlock" Text="{loc:Text 0_Conversions_Done}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeAccent}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Settings Form Card -->
                            <Border Background="{StaticResource ThemeCard}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{loc:Text App_Language}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                                            <TextBlock x:Name="LanguageRestartHint" Text="{loc:Text Restart_FlowConverter_to_apply_the_selected}"
                                                       FontSize="11" Foreground="{StaticResource ThemeAccent}" TextWrapping="Wrap"
                                                       Visibility="Collapsed" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                                  DisplayMemberPath="Name" SelectedValuePath="Code" VerticalAlignment="Top"
                                                  SelectionChanged="LanguageComboBox_SelectionChanged"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource ThemeBorder}" Margin="0,0,0,14"/>

                                    <!-- Theme Selector -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Text Radial_Wheel_Theme}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                                            <TextBlock Text="{loc:Text Visual_appearance_of_the_radial_petals}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ThemeComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectionChanged="ThemeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="{loc:Text Glass_Translucent}"/>
                                            <ComboBoxItem Content="{loc:Text Metallic_High_Contrast}"/>
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource ThemeBorder}" Margin="0,0,0,14"/>

                                    <!-- Sound & Haptic Toggle -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Text Sound_Audio_Feedback}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                                            <TextBlock Text="{loc:Text Play_55ms_harmonic_chime_C6_G6}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SoundsCheckBox" Grid.Column="1" Content="{loc:Text Enable}" Foreground="{StaticResource ThemeText}" VerticalAlignment="Center" Click="SoundsCheckBox_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource ThemeBorder}" Margin="0,0,0,14"/>

                                    <!-- Floating Shelf Behavior -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Text Floating_Drop_Shelf_Behavior}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                                            <TextBlock Text="{loc:Text Behavior_when_dropping_files_onto_the}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="FloatBehaviorComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectionChanged="FloatBehaviorComboBox_SelectionChanged">
                                            <ComboBoxItem Content="{loc:Text Add_to_Existing_Shelf}"/>
                                            <ComboBoxItem Content="{loc:Text Create_New_Shelf_Window}"/>
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource ThemeBorder}" Margin="0,0,0,14"/>

                                    <!-- Terminal Selector -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Text Terminal_Application}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                                            <TextBlock Text="{loc:Text Command_line_terminal_launched_by_Open}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="TerminalComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}" IsEditable="True" LostFocus="TerminalComboBox_LostFocus" SelectionChanged="TerminalComboBox_SelectionChanged">
                                            <ComboBoxItem Content="wt.exe"/>
                                            <ComboBoxItem Content="powershell.exe"/>
                                            <ComboBoxItem Content="cmd.exe"/>
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource ThemeBorder}" Margin="0,0,0,14"/>

                                    <!-- Startup Toggle -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Text Launch_at_Windows_Startup}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                                            <TextBlock Text="{loc:Text Start_Flow_Converter_in_tray_automatically}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="StartupCheckBox" Grid.Column="1" Content="{loc:Text Enable}" Foreground="{StaticResource ThemeText}" VerticalAlignment="Center" Click="StartupCheckBox_Click"/>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource ThemeBorder}" Margin="0,14"/>
                                    <Grid x:Name="MediaSettings">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{loc:Text Media_Tools_FFmpeg}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                                            <TextBlock x:Name="FfmpegStatusText" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}"
                                                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{loc:Text Configure_FFmpeg}" Style="{StaticResource GhostButton}"
                                                Click="ConfigureFfmpeg_Click" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 1: 3D PRINTERS (.3MF) -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,20,24,24">
                            <!-- Header with Restore Button -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Text 3D_Printers_3MF_Profile_Converter}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                                    <TextBlock Text="{loc:Text Checked_printers_appear_as_petals_on}" FontSize="12" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{loc:Text Restore_Defaults}" Click="RestorePrinters_Click" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Add Printer Card -->
                            <Border Background="{StaticResource ThemeCard}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{loc:Text Add_3D_Printer_to_Catalog}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource ThemeAccent}" Margin="0,0,0,12"/>

                                    <!-- Row 1: Brand & Model Selection -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Text Manufacturer}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="ManufacturerComboBox" Style="{StaticResource DarkComboBox}" SelectionChanged="ManufacturerComboBox_SelectionChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Text Preset_Model_from_84_Catalog_Profiles}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="PresetModelComboBox" Style="{StaticResource DarkComboBox}" SelectionChanged="PresetModelComboBox_SelectionChanged">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 2: Full Slicer Name & Short Wheel Label -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Text Full_Model_Name_Slicer_Profile_ID}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="PrinterNameTextBox" Style="{StaticResource DarkTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Text Wheel_Petal_Label}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="ShortWheelNameTextBox" Style="{StaticResource DarkTextBox}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 3: Dimensions, Nozzle, Firmware & Add Button -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Text Width_X}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="BedWidthTextBox" Style="{StaticResource DarkTextBox}" Text="260"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Text Depth_Y}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="BedDepthTextBox" Style="{StaticResource DarkTextBox}" Text="260"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="{loc:Text Height_Z}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="BedHeightTextBox" Style="{StaticResource DarkTextBox}" Text="260"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="{loc:Text Nozzle}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="NozzleComboBox" Style="{StaticResource DarkComboBox}">
                                                <ComboBoxItem Content="0.2 mm"/>
                                                <ComboBoxItem Content="0.4 mm"/>
                                                <ComboBoxItem Content="0.6 mm"/>
                                                <ComboBoxItem Content="0.8 mm"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="8">
                                            <TextBlock Text="Firmware" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="FirmwareComboBox" Style="{StaticResource DarkComboBox}">
                                                <ComboBoxItem Content="klipper"/>
                                                <ComboBoxItem Content="marlin"/>
                                                <ComboBoxItem Content="reprapfirmware"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <Button Grid.Column="10" Style="{StaticResource PrimaryAccentButton}" Content="{loc:Text Add_Printer}" Click="AddPrinter_Click" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Configured Printers List Header -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Text Configured_3D_Printers}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                                <TextBlock x:Name="ActivePrintersCountTextBlock" Grid.Column="1" Text="{loc:Text 8_active_on_Radial_Wheel}" FontSize="11.5" Foreground="{StaticResource ThemeAccent}"/>
                            </Grid>

                            <!-- Configured Printers ItemsControl -->
                            <ItemsControl x:Name="PrintersItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource ThemeCard}" BorderBrush="{StaticResource ThemeControl}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6" Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding ShowInWheel, Mode=TwoWay}" Click="PrinterShowInWheel_Click" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{loc:Text Show_this_printer_directly_on_the}"/>
                                                <TextBlock Grid.Column="1" Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource ThemeText}"/>
                                                        <Border Background="{StaticResource ThemeCard}" BorderBrush="{StaticResource ThemeOutline}" BorderThickness="0.8" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding Brand}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ThemeAccent}"/>
                                                        </Border>
                                                        <Border Background="{StaticResource ThemeControl}" CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                                                            <TextBlock Text="{Binding ShortWheelName, StringFormat='Wheel: &quot;{0}&quot;'}" FontSize="10" Foreground="{StaticResource ThemeSecondaryText}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DimensionsSummary}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SmallIconButton}" Content="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="10" ToolTip="{loc:Text Move_Up_in_Wheel_Order}" Click="MovePrinterUp_Click" Tag="{Binding}" Margin="0,0,4,0"/>
                                                    <Button Style="{StaticResource SmallIconButton}" Content="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="10" ToolTip="{loc:Text Move_Down_in_Wheel_Order}" Click="MovePrinterDown_Click" Tag="{Binding}" Margin="0,0,6,0"/>
                                                    <Button Style="{StaticResource DangerIconButton}" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" ToolTip="{loc:Text Remove_Printer}" Click="RemovePrinter_Click" Tag="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2: WHEEL SHORTCUTS -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,20,24,24">
                            <TextBlock Text="{loc:Text Wheel_Shortcuts}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                            <TextBlock Text="{loc:Text Choose_modifier_keys_to_summon_each}" FontSize="12" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,16"/>

                            <Border Background="{StaticResource ThemeCard}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Conversion Wheel Row -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Text Conversion_Wheel}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                                            <TextBlock Text="{loc:Text Summons_compatible_output_formats_and_3MF}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ConversionModifierComboBox" Grid.Column="2" Style="{StaticResource DarkComboBox}" SelectionChanged="ModifierComboBox_SelectionChanged"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource ThemeBorder}" Margin="0,0,0,14"/>

                                    <!-- Tools Wheel Row -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Text File_Tools_Wheel}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                                            <TextBlock Text="{loc:Text Summons_contextual_tools_Compress_Redact_Crop}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ToolsModifierComboBox" Grid.Column="2" Style="{StaticResource DarkComboBox}" SelectionChanged="ModifierComboBox_SelectionChanged"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource ThemeBorder}" Margin="0,0,0,14"/>

                                    <!-- Actions Wheel Row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Text Quick_Actions_Wheel}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                                            <TextBlock Text="{loc:Text Summons_actions_Float_Share_Copy_Move}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ActionsModifierComboBox" Grid.Column="2" Style="{StaticResource DarkComboBox}" SelectionChanged="ModifierComboBox_SelectionChanged"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Hint Box -->
                            <Border Background="{StaticResource ThemeCanvas}" BorderBrush="{StaticResource ThemeControl}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{loc:Text Tip_Press_and_hold_the_designated}" FontSize="11.5" Foreground="{StaticResource ThemeSecondaryText}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 3: CONVERSION DEFAULTS -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,20,24,24">
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Text Conversion_Defaults}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                                    <TextBlock Text="{loc:Text Configure_default_quality_parameters_and_media}" FontSize="12" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{loc:Text Restore_Defaults}" Click="RestoreConversionDefaults_Click" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Background="{StaticResource ThemeCard}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                <StackPanel>
                                    <!-- Quality Selector -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Text Default_Conversion_Quality}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                                            <TextBlock Text="{loc:Text Global_encoding_profile_applied_to_images}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="QualityComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectionChanged="QualityComboBox_SelectionChanged">
                                            <ComboBoxItem Content="{loc:Text Compact_Smaller_size}"/>
                                            <ComboBoxItem Content="{loc:Text Balanced_Default}"/>
                                            <ComboBoxItem Content="{loc:Text High_Fidelity}"/>
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource ThemeBorder}" Margin="0,0,0,14"/>

                                    <!-- Preserve Metadata -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Text Preserve_Metadata}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                                            <TextBlock Text="{loc:Text Keep_EXIF_ID3_author_and_creation}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="PreserveMetadataCheckBox" Grid.Column="1" Content="{loc:Text Enable}" Foreground="{StaticResource ThemeText}" VerticalAlignment="Center" Click="PreserveMetadataCheckBox_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource ThemeBorder}" Margin="0,0,0,14"/>

                                    <!-- Audio Bitrate -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Text Audio_Bitrate}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                                            <TextBlock Text="{loc:Text Default_target_bitrate_for_MP3_M4A}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="AudioBitrateComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectionChanged="AudioBitrateComboBox_SelectionChanged">
                                            <ComboBoxItem Content="128 kbps"/>
                                            <ComboBoxItem Content="192 kbps"/>
                                            <ComboBoxItem Content="256 kbps"/>
                                            <ComboBoxItem Content="320 kbps"/>
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource ThemeBorder}" Margin="0,0,0,14"/>

                                    <!-- GIF FPS -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Text GIF_Frame_Rate_FPS}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                                            <TextBlock Text="{loc:Text Framerate_for_video_to_GIF_animated}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="GifFpsComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectionChanged="GifFpsComboBox_SelectionChanged">
                                            <ComboBoxItem Content="10 fps"/>
                                            <ComboBoxItem Content="15 fps"/>
                                            <ComboBoxItem Content="24 fps"/>
                                            <ComboBoxItem Content="30 fps"/>
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource ThemeBorder}" Margin="0,0,0,14"/>

                                    <!-- GIF Width -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Text GIF_Resolution_Width}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                                            <TextBlock Text="{loc:Text Default_width_for_output_GIF_animations}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="GifWidthComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectionChanged="GifWidthComboBox_SelectionChanged">
                                            <ComboBoxItem Content="360 px"/>
                                            <ComboBoxItem Content="480 px"/>
                                            <ComboBoxItem Content="640 px"/>
                                            <ComboBoxItem Content="720 px"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 4: COMPRESSION -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,20,24,24">
                            <TextBlock Text="{loc:Text Compression_Settings}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                            <TextBlock Text="{loc:Text Default_presets_applied_when_running_file}" FontSize="12" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,16"/>

                            <!-- Image Compression Card -->
                            <Border Background="{StaticResource ThemeCard}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{loc:Text Image_Compression}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource ThemeAccent}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Text Default_Image_Compression_Strength}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                                            <TextBlock Text="{loc:Text Quality_vs_size_reduction_preset}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ImageStrengthComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectionChanged="CompressionOption_Changed">
                                            <ComboBoxItem Content="{loc:Text balanced}"/>
                                            <ComboBoxItem Content="{loc:Text strong}"/>
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource ThemeBorder}" Margin="0,0,0,14"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Text Default_Image_Max_Size}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                                            <TextBlock Text="{loc:Text Maximum_pixel_dimension_constraint_for_images}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ImageSizeComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectionChanged="CompressionOption_Changed">
                                            <ComboBoxItem Content="{loc:Text large}"/>
                                            <ComboBoxItem Content="{loc:Text medium}"/>
                                            <ComboBoxItem Content="{loc:Text small}"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Video Compression Card -->
                            <Border Background="{StaticResource ThemeCard}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="{loc:Text Video_Compression}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource ThemeAccent}" Margin="0,0,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Text Default_Video_Compression_Strength}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                                            <TextBlock Text="{loc:Text H_264_CRF_encoding_profile_for}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="VideoStrengthComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectionChanged="CompressionOption_Changed">
                                            <ComboBoxItem Content="{loc:Text balanced}"/>
                                            <ComboBoxItem Content="{loc:Text strong}"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 5: FOLDERS -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,20,24,24">
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Text Authorized_Folders}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                                    <TextBlock Text="{loc:Text FlowConverter_saves_results_beside_the_original}" FontSize="12" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryAccentButton}" Content="{loc:Text Add_Folder}" Click="AddFolder_Click" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Background="{StaticResource ThemeCard}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock x:Name="FoldersEmptyTextBlock" Text="{loc:Text No_authorized_folders_configured_Standard_local}" FontSize="12" Foreground="{StaticResource ThemeSecondaryText}" FontStyle="Italic" Visibility="Collapsed" Margin="4,4,4,8"/>
                                    <ItemsControl x:Name="FoldersItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource ThemeCard}" BorderBrush="{StaticResource ThemeControl}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6" Padding="10,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" Foreground="{StaticResource ThemeText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="2" Style="{StaticResource DangerIconButton}" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" ToolTip="{loc:Text Remove_Folder_Authorization}" Click="RemoveFolder_Click" Tag="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 6: FORMAT MATRIX -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,20,24,24">
                            <TextBlock Text="{loc:Text Supported_Formats_Matrix_46_Formats}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                            <TextBlock Text="{loc:Text All_7_format_categories_and_their}" FontSize="12" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,2,0,16"/>

                            <ItemsControl x:Name="FormatMatrixItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource ThemeCard}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}" VerticalAlignment="Center"/>
                                                    <Border Background="{StaticResource ThemeCard}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormatsCount}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ThemeAccent}"/>
                                                    </Border>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding Badges}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource ThemeCanvas}" BorderBrush="{StaticResource ThemeControl}" BorderThickness="1" CornerRadius="5" Width="106" Margin="0,0,8,8" Padding="8,6">
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource ThemeAccent}" HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding TargetsText}" FontSize="9.5" Foreground="{StaticResource ThemeSecondaryText}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
