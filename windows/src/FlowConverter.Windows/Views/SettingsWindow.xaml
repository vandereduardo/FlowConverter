<Window x:Class="FlowConverter.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:FlowConverter.Windows.Models"
        mc:Ignorable="d"
        Title="Flow Converter Settings"
        Width="820" Height="580"
        MinWidth="820" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#0F131D"
        Foreground="#F0F4FA"
        FontFamily="Segoe UI, Segoe UI Variable Display, sans-serif">

    <Window.Resources>
        <!-- Solid Brushes -->
        <SolidColorBrush x:Key="BackgroundDarkBrush" Color="#0F131D"/>
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#141926"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#161D2C"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#222E42"/>
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#00E5FF"/>
        <SolidColorBrush x:Key="AccentCyanHoverBrush" Color="#33E5FF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F4FA"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8A99B5"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#556885"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#121722"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#26354D"/>
        <SolidColorBrush x:Key="DangerRedBrush" Color="#FF4D4D"/>

        <!-- Dark ScrollBar Style -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="3" Background="#2A374E" Margin="1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" Value="#3D5070"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="true">
                                <Setter Property="Background" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2A384F"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsMouseOver}">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style (inherits custom dark ControlTemplate from App.xaml) -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="#141C2B"/>
            <Setter Property="Foreground" Value="#F0F4FA"/>
            <Setter Property="BorderBrush" Value="#2B3B55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F0F4FA"/>
            <Setter Property="Background" Value="#141C2B"/>
            <Setter Property="BorderBrush" Value="#8A99B5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel x:Name="Layout" Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="14" Height="14" CornerRadius="2"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M 0,4 L 3,7 L 8,1"
                                      Stroke="#00E5FF" StrokeThickness="1.6"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter x:Name="Label" Margin="5,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasContent" Value="False">
                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Layout" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TextBox Style (inherits custom dark ControlTemplate from App.xaml) -->
        <Style x:Key="DarkTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="#141C2B"/>
            <Setter Property="Foreground" Value="#F0F4FA"/>
            <Setter Property="BorderBrush" Value="#2B3B55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="CaretBrush" Value="#00E5FF"/>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryAccentButton" TargetType="Button">
            <Setter Property="Background" Value="#00E5FF"/>
            <Setter Property="Foreground" Value="#08101A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33EBFB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#00B8CC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button Style -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#172132"/>
            <Setter Property="Foreground" Value="#C2D2E8"/>
            <Setter Property="BorderBrush" Value="#24334B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2D42"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#141D2B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Icon Button Style -->
        <Style x:Key="SmallIconButton" TargetType="Button">
            <Setter Property="Background" Value="#162030"/>
            <Setter Property="Foreground" Value="#8A99B5"/>
            <Setter Property="BorderBrush" Value="#223147"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#23344D"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Icon Button Style -->
        <Style x:Key="DangerIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF6B6B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FF4D4D"/>
                                <Setter Property="Foreground" Value="#FFA3A3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ActiveIndicator" Grid.Column="0" Background="#00E5FF" CornerRadius="1.5" Visibility="Collapsed"/>
                                <TextBlock x:Name="NavIcon" Grid.Column="1" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="13.5" Foreground="#8A99B5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavText" Grid.Column="2" Text="{TemplateBinding Content}" FontSize="12" Foreground="#8A99B5" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#182234"/>
                                <Setter TargetName="NavText" Property="Foreground" Value="#F0F4FA"/>
                                <Setter TargetName="NavIcon" Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#0F131D">
        <Grid.ColumnDefinitions>
            <!-- Sidebar: Width 210 -->
            <ColumnDefinition Width="210"/>
            <!-- Content Area: Fill -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="#141926" BorderBrush="#1E2638" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Brand Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Navigation Tabs -->
                    <RowDefinition Height="*"/>
                    <!-- Footer Info -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="14,16,14,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="13" Background="#162D3E" BorderBrush="#00E5FF" BorderThickness="1.2" Margin="0,0,9,0">
                            <TextBlock Text="FC" Foreground="#00E5FF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FLOW CONVERTER" Foreground="#00E5FF" FontSize="11.5" FontWeight="Bold"/>
                            <TextBlock Text="Settings &amp; Preferences" Foreground="#8A99B5" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1" Background="#1E2638" Margin="0,14,0,0"/>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Row="1" Margin="8,4,8,0">
                    <Button x:Name="BtnNavGeneral" Style="{StaticResource SidebarNavButtonStyle}" Tag="&#xE713;" Content="General" Click="SidebarTab_Click"/>
                    <Button x:Name="BtnNavPrinters" Style="{StaticResource SidebarNavButtonStyle}" Tag="&#xE749;" Content="3D Printers (.3MF)" Click="SidebarTab_Click"/>
                    <Button x:Name="BtnNavShortcuts" Style="{StaticResource SidebarNavButtonStyle}" Tag="&#xE765;" Content="Wheel Shortcuts" Click="SidebarTab_Click"/>
                    <Button x:Name="BtnNavConversions" Style="{StaticResource SidebarNavButtonStyle}" Tag="&#xE895;" Content="Conversion Defaults" Click="SidebarTab_Click"/>
                    <Button x:Name="BtnNavCompression" Style="{StaticResource SidebarNavButtonStyle}" Tag="&#xE7B8;" Content="Compression" Click="SidebarTab_Click"/>
                    <Button x:Name="BtnNavFolders" Style="{StaticResource SidebarNavButtonStyle}" Tag="&#xE8B7;" Content="Folders" Click="SidebarTab_Click"/>
                    <Button x:Name="BtnNavMatrix" Style="{StaticResource SidebarNavButtonStyle}" Tag="&#xF0E2;" Content="Format Matrix" Click="SidebarTab_Click"/>
                </StackPanel>

                <!-- Footer Status -->
                <StackPanel Grid.Row="2" Margin="14,10,14,14" Opacity="0.8">
                    <Border Height="1" Background="#1E2638" Margin="0,0,0,10"/>
                    <TextBlock Text="Open Source Unlocked · MIT" Foreground="#5A6B85" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock Text="Clean-Room Windows Parity" Foreground="#3F4D63" FontSize="9" Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT CONTENT AREA -->
        <Grid Grid.Column="1" Background="#0F131D">
            <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0" Padding="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- TAB 0: GENERAL -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,20,24,24">
                            <!-- Section Title -->
                            <TextBlock Text="General Settings" FontSize="19" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                            <TextBlock Text="Application behavior, visual themes, and startup options." FontSize="12" Foreground="#8A99B5" Margin="0,2,0,16"/>

                            <!-- Status Card: Open Source Unlocked -->
                            <Border Background="#131D2D" BorderBrush="#1F334E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#162D3E" BorderBrush="#00E5FF" BorderThickness="1.2" Margin="0,0,12,0">
                                        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Open Source Unlocked (MIT Edition)" FontWeight="Bold" FontSize="13" Foreground="#F0F4FA"/>
                                        <TextBlock Text="Unlimited conversions, batch drops, all 29 media tools, and 84 3D printer profiles." FontSize="11.5" Foreground="#8A99B5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#122738" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="5" Padding="10,5" VerticalAlignment="Center">
                                        <TextBlock x:Name="UsageCountTextBlock" Text="0 Conversions Done" FontSize="11.5" FontWeight="SemiBold" Foreground="#00E5FF"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Settings Form Card -->
                            <Border Background="#161D2C" BorderBrush="#222E42" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                <StackPanel>
                                    <!-- Theme Selector -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Radial Wheel Theme" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                                            <TextBlock Text="Visual appearance of the radial petals and center hub" FontSize="11" Foreground="#8A99B5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ThemeComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectionChanged="ThemeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Glass (Translucent Obsidian)"/>
                                            <ComboBoxItem Content="Metallic (High Contrast)"/>
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="#1E283A" Margin="0,0,0,14"/>

                                    <!-- Sound & Haptic Toggle -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Sound &amp; Audio Feedback" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                                            <TextBlock Text="Play 55ms harmonic chime (C6+G6) when petals activate" FontSize="11" Foreground="#8A99B5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SoundsCheckBox" Grid.Column="1" Content="Enable" Foreground="#F0F4FA" VerticalAlignment="Center" Click="SoundsCheckBox_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="#1E283A" Margin="0,0,0,14"/>

                                    <!-- Floating Shelf Behavior -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Floating Drop Shelf Behavior" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                                            <TextBlock Text="Behavior when dropping files onto the 'Float' action petal" FontSize="11" Foreground="#8A99B5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="FloatBehaviorComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectionChanged="FloatBehaviorComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Add to Existing Shelf"/>
                                            <ComboBoxItem Content="Create New Shelf Window"/>
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="#1E283A" Margin="0,0,0,14"/>

                                    <!-- Terminal Selector -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Terminal Application" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                                            <TextBlock Text="Command-line terminal launched by 'Open Terminal' petal" FontSize="11" Foreground="#8A99B5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="TerminalComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}" IsEditable="True" LostFocus="TerminalComboBox_LostFocus" SelectionChanged="TerminalComboBox_SelectionChanged">
                                            <ComboBoxItem Content="wt.exe"/>
                                            <ComboBoxItem Content="powershell.exe"/>
                                            <ComboBoxItem Content="cmd.exe"/>
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="#1E283A" Margin="0,0,0,14"/>

                                    <!-- Startup Toggle -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Launch at Windows Startup" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                                            <TextBlock Text="Start Flow Converter in tray automatically on login" FontSize="11" Foreground="#8A99B5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="StartupCheckBox" Grid.Column="1" Content="Enable" Foreground="#F0F4FA" VerticalAlignment="Center" Click="StartupCheckBox_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 1: 3D PRINTERS (.3MF) -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,20,24,24">
                            <!-- Header with Restore Button -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="3D Printers (.3MF Profile Converter)" FontSize="19" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                                    <TextBlock Text="Checked printers appear as petals on the wheel when dragging .3mf project files." FontSize="12" Foreground="#8A99B5" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Restore Defaults" Click="RestorePrinters_Click" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Add Printer Card -->
                            <Border Background="#161D2C" BorderBrush="#222E42" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Add 3D Printer to Catalog" FontSize="13" FontWeight="SemiBold" Foreground="#00E5FF" Margin="0,0,0,12"/>

                                    <!-- Row 1: Brand & Model Selection -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Manufacturer" FontSize="11" Foreground="#8A99B5" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="ManufacturerComboBox" Style="{StaticResource DarkComboBox}" SelectionChanged="ManufacturerComboBox_SelectionChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Preset Model (from 84 Catalog Profiles)" FontSize="11" Foreground="#8A99B5" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="PresetModelComboBox" Style="{StaticResource DarkComboBox}" SelectionChanged="PresetModelComboBox_SelectionChanged">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 2: Full Slicer Name & Short Wheel Label -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Full Model Name (Slicer Profile ID)" FontSize="11" Foreground="#8A99B5" Margin="0,0,0,4"/>
                                            <TextBox x:Name="PrinterNameTextBox" Style="{StaticResource DarkTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Wheel Petal Label" FontSize="11" Foreground="#8A99B5" Margin="0,0,0,4"/>
                                            <TextBox x:Name="ShortWheelNameTextBox" Style="{StaticResource DarkTextBox}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 3: Dimensions, Nozzle, Firmware & Add Button -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Width (X)" FontSize="11" Foreground="#8A99B5" Margin="0,0,0,4"/>
                                            <TextBox x:Name="BedWidthTextBox" Style="{StaticResource DarkTextBox}" Text="260"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Depth (Y)" FontSize="11" Foreground="#8A99B5" Margin="0,0,0,4"/>
                                            <TextBox x:Name="BedDepthTextBox" Style="{StaticResource DarkTextBox}" Text="260"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Height (Z)" FontSize="11" Foreground="#8A99B5" Margin="0,0,0,4"/>
                                            <TextBox x:Name="BedHeightTextBox" Style="{StaticResource DarkTextBox}" Text="260"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Nozzle" FontSize="11" Foreground="#8A99B5" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="NozzleComboBox" Style="{StaticResource DarkComboBox}">
                                                <ComboBoxItem Content="0.2 mm"/>
                                                <ComboBoxItem Content="0.4 mm"/>
                                                <ComboBoxItem Content="0.6 mm"/>
                                                <ComboBoxItem Content="0.8 mm"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="8">
                                            <TextBlock Text="Firmware" FontSize="11" Foreground="#8A99B5" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="FirmwareComboBox" Style="{StaticResource DarkComboBox}">
                                                <ComboBoxItem Content="klipper"/>
                                                <ComboBoxItem Content="marlin"/>
                                                <ComboBoxItem Content="reprapfirmware"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <Button Grid.Column="10" Style="{StaticResource PrimaryAccentButton}" Content="+ Add Printer" Click="AddPrinter_Click" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Configured Printers List Header -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Configured 3D Printers" FontSize="13" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                                <TextBlock x:Name="ActivePrintersCountTextBlock" Grid.Column="1" Text="8 active on Radial Wheel" FontSize="11.5" Foreground="#00E5FF"/>
                            </Grid>

                            <!-- Configured Printers ItemsControl -->
                            <ItemsControl x:Name="PrintersItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#141C2B" BorderBrush="#1F2A3D" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6" Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding ShowInWheel, Mode=TwoWay}" Click="PrinterShowInWheel_Click" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Show this printer directly on the Radial Wheel for .3MF files"/>
                                                <TextBlock Grid.Column="1" Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="#F0F4FA"/>
                                                        <Border Background="#162D3E" BorderBrush="#00E5FF" BorderThickness="0.8" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding Brand}" FontSize="10" FontWeight="SemiBold" Foreground="#00E5FF"/>
                                                        </Border>
                                                        <Border Background="#1A2436" CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                                                            <TextBlock Text="{Binding ShortWheelName, StringFormat='Wheel: &quot;{0}&quot;'}" FontSize="10" Foreground="#8A99B5"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DimensionsSummary}" FontSize="11" Foreground="#8A99B5" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SmallIconButton}" Content="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="10" ToolTip="Move Up in Wheel Order" Click="MovePrinterUp_Click" Tag="{Binding}" Margin="0,0,4,0"/>
                                                    <Button Style="{StaticResource SmallIconButton}" Content="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="10" ToolTip="Move Down in Wheel Order" Click="MovePrinterDown_Click" Tag="{Binding}" Margin="0,0,6,0"/>
                                                    <Button Style="{StaticResource DangerIconButton}" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" ToolTip="Remove Printer" Click="RemovePrinter_Click" Tag="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2: WHEEL SHORTCUTS -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,20,24,24">
                            <TextBlock Text="Wheel Shortcuts" FontSize="19" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                            <TextBlock Text="Choose modifier keys to summon each radial wheel while dragging files." FontSize="12" Foreground="#8A99B5" Margin="0,2,0,16"/>

                            <Border Background="#161D2C" BorderBrush="#222E42" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Conversion Wheel Row -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Conversion Wheel" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                                            <TextBlock Text="Summons compatible output formats and .3MF target printers" FontSize="11" Foreground="#8A99B5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ConversionModifierComboBox" Grid.Column="2" Style="{StaticResource DarkComboBox}" SelectionChanged="ModifierComboBox_SelectionChanged"/>
                                    </Grid>
                                    <Border Height="1" Background="#1E283A" Margin="0,0,0,14"/>

                                    <!-- Tools Wheel Row -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="File Tools Wheel" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                                            <TextBlock Text="Summons contextual tools (Compress, Redact, Crop, PDF, Media)" FontSize="11" Foreground="#8A99B5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ToolsModifierComboBox" Grid.Column="2" Style="{StaticResource DarkComboBox}" SelectionChanged="ModifierComboBox_SelectionChanged"/>
                                    </Grid>
                                    <Border Height="1" Background="#1E283A" Margin="0,0,0,14"/>

                                    <!-- Actions Wheel Row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Quick Actions Wheel" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                                            <TextBlock Text="Summons actions (Float, Share, Copy, Move, Copy Path, Terminal)" FontSize="11" Foreground="#8A99B5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ActionsModifierComboBox" Grid.Column="2" Style="{StaticResource DarkComboBox}" SelectionChanged="ModifierComboBox_SelectionChanged"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Hint Box -->
                            <Border Background="#121824" BorderBrush="#1C2738" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Tip: Press and hold the designated modifier key while dragging files from File Explorer to summon the radial wheel directly at cursor coordinates." FontSize="11.5" Foreground="#8A99B5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 3: CONVERSION DEFAULTS -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,20,24,24">
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Conversion Defaults" FontSize="19" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                                    <TextBlock Text="Configure default quality parameters and media encoding settings." FontSize="12" Foreground="#8A99B5" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Restore Defaults" Click="RestoreConversionDefaults_Click" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Background="#161D2C" BorderBrush="#222E42" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                <StackPanel>
                                    <!-- Quality Selector -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Default Conversion Quality" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                                            <TextBlock Text="Global encoding profile applied to images, audio, and video" FontSize="11" Foreground="#8A99B5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="QualityComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectionChanged="QualityComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Compact (Smaller size)"/>
                                            <ComboBoxItem Content="Balanced (Default)"/>
                                            <ComboBoxItem Content="High (Fidelity)"/>
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="#1E283A" Margin="0,0,0,14"/>

                                    <!-- Preserve Metadata -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Preserve Metadata" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                                            <TextBlock Text="Keep EXIF, ID3, author, and creation timestamps in output files" FontSize="11" Foreground="#8A99B5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="PreserveMetadataCheckBox" Grid.Column="1" Content="Enable" Foreground="#F0F4FA" VerticalAlignment="Center" Click="PreserveMetadataCheckBox_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="#1E283A" Margin="0,0,0,14"/>

                                    <!-- Audio Bitrate -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Audio Bitrate" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                                            <TextBlock Text="Default target bitrate for MP3, M4A, and AAC conversions" FontSize="11" Foreground="#8A99B5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="AudioBitrateComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectionChanged="AudioBitrateComboBox_SelectionChanged">
                                            <ComboBoxItem Content="128 kbps"/>
                                            <ComboBoxItem Content="192 kbps"/>
                                            <ComboBoxItem Content="256 kbps"/>
                                            <ComboBoxItem Content="320 kbps"/>
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="#1E283A" Margin="0,0,0,14"/>

                                    <!-- GIF FPS -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="GIF Frame Rate (FPS)" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                                            <TextBlock Text="Framerate for video-to-GIF animated conversions" FontSize="11" Foreground="#8A99B5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="GifFpsComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectionChanged="GifFpsComboBox_SelectionChanged">
                                            <ComboBoxItem Content="10 fps"/>
                                            <ComboBoxItem Content="15 fps"/>
                                            <ComboBoxItem Content="24 fps"/>
                                            <ComboBoxItem Content="30 fps"/>
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="#1E283A" Margin="0,0,0,14"/>

                                    <!-- GIF Width -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="GIF Resolution Width" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                                            <TextBlock Text="Default width for output GIF animations" FontSize="11" Foreground="#8A99B5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="GifWidthComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectionChanged="GifWidthComboBox_SelectionChanged">
                                            <ComboBoxItem Content="360 px"/>
                                            <ComboBoxItem Content="480 px"/>
                                            <ComboBoxItem Content="640 px"/>
                                            <ComboBoxItem Content="720 px"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 4: COMPRESSION -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,20,24,24">
                            <TextBlock Text="Compression Settings" FontSize="19" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                            <TextBlock Text="Default presets applied when running file compression tools." FontSize="12" Foreground="#8A99B5" Margin="0,2,0,16"/>

                            <!-- Image Compression Card -->
                            <Border Background="#161D2C" BorderBrush="#222E42" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Image Compression" FontSize="13" FontWeight="SemiBold" Foreground="#00E5FF" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Default Image Compression Strength" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                                            <TextBlock Text="Quality vs size reduction preset" FontSize="11" Foreground="#8A99B5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ImageStrengthComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectionChanged="CompressionOption_Changed">
                                            <ComboBoxItem Content="balanced"/>
                                            <ComboBoxItem Content="strong"/>
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="#1E283A" Margin="0,0,0,14"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Default Image Max Size" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                                            <TextBlock Text="Maximum pixel dimension constraint for images" FontSize="11" Foreground="#8A99B5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ImageSizeComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectionChanged="CompressionOption_Changed">
                                            <ComboBoxItem Content="large"/>
                                            <ComboBoxItem Content="medium"/>
                                            <ComboBoxItem Content="small"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Video Compression Card -->
                            <Border Background="#161D2C" BorderBrush="#222E42" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="Video Compression" FontSize="13" FontWeight="SemiBold" Foreground="#00E5FF" Margin="0,0,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Default Video Compression Strength" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                                            <TextBlock Text="H.264 CRF encoding profile for video reductions" FontSize="11" Foreground="#8A99B5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="VideoStrengthComboBox" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectionChanged="CompressionOption_Changed">
                                            <ComboBoxItem Content="balanced"/>
                                            <ComboBoxItem Content="strong"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 5: FOLDERS -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,20,24,24">
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Authorized Folders" FontSize="19" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                                    <TextBlock Text="FlowConverter saves results beside the original files or in authorized target directories." FontSize="12" Foreground="#8A99B5" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryAccentButton}" Content="+ Add Folder…" Click="AddFolder_Click" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Background="#161D2C" BorderBrush="#222E42" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock x:Name="FoldersEmptyTextBlock" Text="No authorized folders configured. Standard local file access is active beside originals." FontSize="12" Foreground="#8A99B5" FontStyle="Italic" Visibility="Collapsed" Margin="4,4,4,8"/>
                                    <ItemsControl x:Name="FoldersItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#141C2B" BorderBrush="#1F2A3D" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6" Padding="10,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" Foreground="#F0F4FA" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="2" Style="{StaticResource DangerIconButton}" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" ToolTip="Remove Folder Authorization" Click="RemoveFolder_Click" Tag="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 6: FORMAT MATRIX -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,20,24,24">
                            <TextBlock Text="Supported Formats Matrix (46 Formats)" FontSize="19" FontWeight="SemiBold" Foreground="#F0F4FA"/>
                            <TextBlock Text="All 7 format categories and their compatible output conversion targets." FontSize="12" Foreground="#8A99B5" Margin="0,2,0,16"/>

                            <ItemsControl x:Name="FormatMatrixItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#161D2C" BorderBrush="#222E42" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="#F0F4FA" VerticalAlignment="Center"/>
                                                    <Border Background="#162D3E" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormatsCount}" FontSize="10" FontWeight="SemiBold" Foreground="#00E5FF"/>
                                                    </Border>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding Badges}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#121824" BorderBrush="#1F2A3D" BorderThickness="1" CornerRadius="5" Width="106" Margin="0,0,8,8" Padding="8,6">
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" Foreground="#00E5FF" HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding TargetsText}" FontSize="9.5" Foreground="#8A99B5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
