<Window x:Class="FlowConverter.Windows.Views.FloatingShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FlowConverter.Windows.Localization"
        Title="{loc:Text Float_Drop_Shelf}"
        Width="290" Height="340"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <!-- Header Icon Button Style -->
        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource ThemeMutedText}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="4" Width="20" Height="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource ThemeBorder}" />
                                <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Footer Ghost Button Style -->
        <Style x:Key="FooterGhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ThemeControl}" />
            <Setter Property="Foreground" Value="{StaticResource ThemeSecondaryText}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource ThemeHover}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource ThemeFocus}" />
                                <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Footer Convert Button Style -->
        <Style x:Key="FooterPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ThemeAccent}" />
            <Setter Property="Foreground" Value="{StaticResource ThemeOnAccent}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource ThemeAccentHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Context Menu for Items -->
        <ContextMenu x:Key="ItemContextMenu" Background="{StaticResource ThemeCard}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="Surface" Background="Transparent" Padding="12,6">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Surface" Property="Background" Value="{StaticResource ThemeHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ContextMenu.Resources>
            <MenuItem Header="{loc:Text Open}" Click="MenuItemOpen_Click" Foreground="{StaticResource ThemeText}" />
            <MenuItem Header="{loc:Text Reveal_in_Explorer}" Click="MenuItemReveal_Click" Foreground="{StaticResource ThemeText}" />
            <Separator Background="{StaticResource ThemeBorder}" />
            <MenuItem Header="{loc:Text Copy_File}" Click="MenuItemCopyFile_Click" Foreground="{StaticResource ThemeText}" />
            <MenuItem Header="{loc:Text Copy_Path}" Click="MenuItemCopyPath_Click" Foreground="{StaticResource ThemeText}" />
            <Separator Background="{StaticResource ThemeBorder}" />
            <MenuItem Header="{loc:Text Remove}" Click="MenuItemRemove_Click" Foreground="{StaticResource ThemeDanger}" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <!-- ========================================================= -->
        <!-- STATE 1: EXPANDED MODE (Width 290, Height 340)             -->
        <!-- ========================================================= -->
        <Border x:Name="ExpandedRoot"
                Background="{StaticResource ThemeWindow}"
                BorderBrush="{StaticResource ThemeBorder}"
                BorderThickness="1"
                CornerRadius="14"
                Margin="6"
                Visibility="Visible">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.75" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Divider -->
                    <RowDefinition Height="1" />
                    <!-- Items Area -->
                    <RowDefinition Height="*" />
                    <!-- Divider -->
                    <RowDefinition Height="1" />
                    <!-- Footer -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header Bar: Draggable -->
                <Grid Grid.Row="0" Margin="10,8,8,8" MouseDown="Header_MouseDown" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Paperclip Icon -->
                    <Path Grid.Column="0"
                          Data="M 7,1 C 3.7,1 1,3.7 1,7 L 1,15 C 1,18.8 4.1,22 8,22 C 11.9,22 15,18.8 15,15 L 15,5 C 15,2.8 13.2,1 11,1 C 8.8,1 7,2.8 7,5 L 7,14 C 7,15.1 7.9,16 9,16 C 10.1,16 11,15.1 11,14 L 11,5"
                          Stroke="{StaticResource ThemeAccent}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Width="16" Height="18"
                          Stretch="Uniform"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center" />

                    <!-- Title -->
                    <TextBlock x:Name="TitleTextBlock"
                               Grid.Column="1"
                               Text="{loc:Text Float_0}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ThemeText}"
                               VerticalAlignment="Center" />

                    <!-- Grid / List Toggle Button -->
                    <Button x:Name="ToggleViewModeButton"
                            Grid.Column="2"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            Click="ToggleViewMode_Click"
                            ToolTip="{loc:Text Toggle_Grid_List_View}"
                            Margin="0,0,4,0">
                        <TextBlock x:Name="ToggleViewModeIcon" Text="☰" FontSize="11" />
                    </Button>

                    <!-- Collapse Button -->
                    <Button x:Name="CollapseButton"
                            Grid.Column="3"
                            Content="—"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            Click="CollapseButton_Click"
                            ToolTip="{loc:Text Collapse_Float}"
                            Margin="0,0,4,0" />

                    <!-- Close Button -->
                    <Button x:Name="CloseButton"
                            Grid.Column="4"
                            Content="✕"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="{loc:Text Close_Float_Shelf}" />
                </Grid>

                <!-- Top Divider -->
                <Rectangle Grid.Row="1" Fill="{StaticResource ThemeControl}" Height="1" />

                <!-- Items Container -->
                <Grid Grid.Row="2" Margin="6">
                    <!-- Empty State Placeholder -->
                    <Border x:Name="EmptyPlaceholderBorder"
                            Background="{StaticResource ThemeCard}"
                            BorderBrush="{StaticResource ThemeControl}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="4"
                            Padding="12"
                            Visibility="Visible">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Data="M 7,1 C 3.7,1 1,3.7 1,7 L 1,15 C 1,18.8 4.1,22 8,22 C 11.9,22 15,18.8 15,15 L 15,5 C 15,2.8 13.2,1 11,1 C 8.8,1 7,2.8 7,5 L 7,14 C 7,15.1 7.9,16 9,16 C 10.1,16 11,15.1 11,14 L 11,5"
                                  Stroke="{StaticResource ThemeAccent}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="24" Height="26" Stretch="Uniform"
                                  Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="{loc:Text Drop_files_here_to_float}"
                                       FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource ThemeSecondaryText}" HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Text Hold_Ctrl_while_dragging}"
                                       FontSize="10" Foreground="{StaticResource ThemeMutedText}"
                                       HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Grid View ScrollViewer -->
                    <ScrollViewer x:Name="GridItemsScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <ItemsControl x:Name="GridItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="80" Height="82"
                                            Background="{StaticResource ThemeControl}"
                                            BorderBrush="{StaticResource ThemeBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="3"
                                            Padding="4"
                                            Cursor="Hand"
                                            ContextMenu="{StaticResource ItemContextMenu}"
                                            PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="Item_PreviewMouseMove"
                                            MouseLeftButtonUp="Item_MouseLeftButtonUp">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource ThemeOutline}" />
                                                        <Setter Property="Background" Value="{StaticResource ThemeControl}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <!-- Thumbnail / Icon -->
                                            <Image Grid.Row="0"
                                                   Source="{Binding IconSource}"
                                                   Width="30" Height="30"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />

                                            <!-- Extension Badge -->
                                            <Border Grid.Row="1"
                                                    Background="{StaticResource ThemeHover}"
                                                    CornerRadius="3"
                                                    Padding="4,1"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,1,0,1">
                                                <TextBlock Text="{Binding Extension}"
                                                           FontSize="8.5"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource ThemeAccent}" />
                                            </Border>

                                            <!-- File Name -->
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding FileName}"
                                                       FontSize="9.5"
                                                       Foreground="{StaticResource ThemeSecondaryText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- List View ScrollViewer -->
                    <ScrollViewer x:Name="ListItemsScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <ItemsControl x:Name="ListItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="36"
                                            Background="{StaticResource ThemeControl}"
                                            BorderBrush="{StaticResource ThemeBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,2"
                                            Padding="6,3"
                                            Cursor="Hand"
                                            ContextMenu="{StaticResource ItemContextMenu}"
                                            PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="Item_PreviewMouseMove"
                                            MouseLeftButtonUp="Item_MouseLeftButtonUp">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource ThemeOutline}" />
                                                        <Setter Property="Background" Value="{StaticResource ThemeControl}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon -->
                                            <Image Grid.Column="0"
                                                   Source="{Binding IconSource}"
                                                   Width="20" Height="20"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />

                                            <!-- File Name -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding FileName}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource ThemeText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />

                                            <!-- Extension Badge -->
                                            <Border Grid.Column="2"
                                                    Background="{StaticResource ThemeHover}"
                                                    CornerRadius="3"
                                                    Padding="4,1"
                                                    Margin="4,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Extension}"
                                                           FontSize="8.5"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource ThemeAccent}" />
                                            </Border>

                                            <!-- File Size -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding FormattedSize}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource ThemeMutedText}"
                                                       Margin="4,0"
                                                       VerticalAlignment="Center" />

                                            <!-- Remove Button -->
                                            <Button Grid.Column="4"
                                                    Content="✕"
                                                    Style="{StaticResource HeaderIconButtonStyle}"
                                                    Click="RemoveItemButton_Click"
                                                    ToolTip="{loc:Text Remove_from_Shelf}"
                                                    Margin="2,0,0,0"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Bottom Divider -->
                <Rectangle Grid.Row="3" Fill="{StaticResource ThemeControl}" Height="1" />

                <!-- Footer Bar -->
                <Grid Grid.Row="4" Margin="10,6,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="{loc:Text Copy_All}"
                            Style="{StaticResource FooterGhostButtonStyle}"
                            Click="CopyAll_Click"
                            ToolTip="{loc:Text Copy_all_files_to_clipboard}"
                            Margin="0,0,6,0" />

                    <Button Grid.Column="1"
                            Content="{loc:Text Clear}"
                            Style="{StaticResource FooterGhostButtonStyle}"
                            Click="Clear_Click"
                            ToolTip="{loc:Text Clear_shelf}" />

                    <Button Grid.Column="3"
                            Content="{loc:Text Convert_All}"
                            Style="{StaticResource FooterPrimaryButtonStyle}"
                            Click="ConvertAll_Click"
                            ToolTip="{loc:Text Launch_radial_conversion_for_all_items}" />
                </Grid>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- STATE 2: COMPACT MODE (Width 104, Height 112)              -->
        <!-- ========================================================= -->
        <Border x:Name="CompactRoot"
                Background="{StaticResource ThemeWindow}"
                BorderBrush="{StaticResource ThemeOutline}"
                BorderThickness="1.5"
                CornerRadius="18"
                Margin="6"
                Cursor="Hand"
                Visibility="Collapsed"
                PreviewMouseLeftButtonDown="CompactRoot_PreviewMouseLeftButtonDown"
                PreviewMouseMove="CompactRoot_PreviewMouseMove"
                PreviewMouseLeftButtonUp="CompactRoot_PreviewMouseLeftButtonUp">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.8" />
            </Border.Effect>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Paperclip Icon -->
                <Path Data="M 7,1 C 3.7,1 1,3.7 1,7 L 1,15 C 1,18.8 4.1,22 8,22 C 11.9,22 15,18.8 15,15 L 15,5 C 15,2.8 13.2,1 11,1 C 8.8,1 7,2.8 7,5 L 7,14 C 7,15.1 7.9,16 9,16 C 10.1,16 11,15.1 11,14 L 11,5"
                      Stroke="{StaticResource ThemeAccent}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Width="26" Height="28"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,6" />

                <!-- Files Count Badge -->
                <TextBlock x:Name="CompactCountTextBlock"
                           Text="{loc:Text 0_files}"
                           FontSize="11.5"
                           FontWeight="Bold"
                           Foreground="{StaticResource ThemeText}"
                           HorizontalAlignment="Center" />

                <!-- Hint Text -->
                <TextBlock Text="{loc:Text Click_to_expand}"
                           FontSize="9"
                           Foreground="{StaticResource ThemeMutedText}"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
