<Window x:Class="FlowConverter.Windows.Views.ToolWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FlowConverter.Windows.Localization"
        Title="{loc:Text FlowConverter_Studio}"
        Width="820" Height="660"
        MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#0D111A"
        Foreground="#F0F4FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="#131926" BorderBrush="#222C42" BorderThickness="0,0,0,1" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1A00E5FF" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,14,0">
                        <TextBlock x:Name="ToolIconText" Text="🛠" FontSize="18" Foreground="#00E5FF"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ToolTitleText" Text="{loc:Text 3MF_Printer_Converter}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock x:Name="ToolSubtitleText" Text="{loc:Text Inspect_and_convert_3MF_projects_across}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="#1B2336" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock x:Name="FileCountBadgeText" Text="{loc:Text 1_file_selected}" Foreground="#00E5FF" FontSize="11.5" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Dynamic Scrollable Workspace Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18">
            <StackPanel x:Name="WorkspaceContentPanel"/>
        </ScrollViewer>

        <!-- Footer Bar -->
        <Border Grid.Row="2" Background="#131926" BorderBrush="#222C42" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatusText"
                           Text="{loc:Text Ready_to_process}"
                           Foreground="#94A3B8"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{loc:Text Cancel}"
                            Width="100" Height="36"
                            Margin="0,0,10,0"
                            Background="#1E2638"
                            Foreground="#E2E8F0"
                            BorderBrush="#334155"
                            Click="OnCancelClick"/>
                    <Button x:Name="ExecuteButton"
                            Content="{loc:Text Execute_Tool}"
                            Width="170" Height="36"
                            Background="#00E5FF"
                            Foreground="#090D16"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="OnExecuteClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
