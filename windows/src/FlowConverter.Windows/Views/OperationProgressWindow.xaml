<Window x:Class="FlowConverter.Windows.Views.OperationProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flow Converter Operation"
        Width="400" Height="165"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- Modern Rounded Cyan ProgressBar Template -->
        <Style x:Key="CyanProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="#1E2638" />
            <Setter Property="Foreground" Value="#00E5FF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="3.5" />
                            <Border x:Name="PART_Track" />
                            <Grid x:Name="PART_Indicator"
                                  ClipToBounds="True"
                                  HorizontalAlignment="Left">
                                <Border Background="{TemplateBinding Foreground}"
                                        CornerRadius="3.5" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Dismiss Button -->
        <Style x:Key="ProgressDismissButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1C2333" />
            <Setter Property="Foreground" Value="#C2D0E4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="#2F3C54" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#29354C" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#00E5FF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#7888A2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="10" Width="20" Height="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2A3345" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Rounded Obsidian Card with Cyan Glow Border -->
    <Border Background="#121622"
            BorderBrush="#00E5FF"
            BorderThickness="1.5"
            CornerRadius="12"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.8" />
        </Border.Effect>

        <Grid Margin="16,12,16,12">
            <Grid.RowDefinitions>
                <!-- Title Row -->
                <RowDefinition Height="Auto" />
                <!-- Status Row -->
                <RowDefinition Height="*" />
                <!-- Progress & Percent Row -->
                <RowDefinition Height="Auto" />
                <!-- Actions / Error Dismiss Row -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header Row -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Cockpit Indicator Glyph -->
                <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9"
                        Background="#192538" BorderBrush="#00E5FF" BorderThickness="1.2"
                        Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Operation Title -->
                <TextBlock x:Name="TitleTextBlock"
                           Grid.Column="1"
                           Text="Converting Files…"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Items Badge -->
                <Border x:Name="ItemsBadgeBorder"
                        Grid.Column="2"
                        Background="#1C2436"
                        BorderBrush="#2B374E"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,1"
                        Margin="8,0,4,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="ItemsBadgeTextBlock"
                               Text="1 item"
                               FontSize="10.5"
                               Foreground="#8C9AB5" />
                </Border>

                <!-- Top Close Button (for manual dismiss on error) -->
                <Button x:Name="HeaderCloseButton"
                        Grid.Column="3"
                        Content="✕"
                        Style="{StaticResource MiniCloseButtonStyle}"
                        Click="CloseButton_Click"
                        Visibility="Collapsed"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center" />
            </Grid>

            <!-- Status Details -->
            <TextBlock x:Name="StatusTextBlock"
                       Grid.Row="1"
                       Text="Processing…"
                       FontSize="11.5"
                       Foreground="#8E9BB5"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Margin="0,4,0,4" />

            <!-- Progress Bar + Percentage -->
            <Grid Grid.Row="2" Margin="0,4,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar x:Name="MainProgressBar"
                             Grid.Column="0"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Style="{StaticResource CyanProgressBarStyle}" />

                <TextBlock x:Name="PercentTextBlock"
                           Grid.Column="1"
                           Text="0%"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="#00E5FF"
                           Width="42"
                           TextAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Bottom Error / Dismiss Row -->
            <Grid Grid.Row="3" Margin="0,4,0,0">
                <Button x:Name="CloseButton"
                        Content="Close"
                        Style="{StaticResource ProgressDismissButtonStyle}"
                        Click="CloseButton_Click"
                        Visibility="Collapsed"
                        HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Border>
</Window>
